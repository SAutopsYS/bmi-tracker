# Firebase / Google services secrets
# Keep lib/firebase_options.dart as the project placeholder.
# Do not commit real google-services.json / GoogleService-Info.plist with secrets.
**/google-services.json
**/GoogleService-Info.plist
firebase_options.prod.dart

